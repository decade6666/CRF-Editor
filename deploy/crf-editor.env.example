# CRF Editor 生产环境变量（由 install-service.sh 复制到 /etc/crf-editor/crf-editor.env）
# 说明：
# - CRF_AUTH_SECRET_KEY 由安装脚本自动生成随机值；如需自管，可改为自选长随机字符串
# - CRF_ADMIN_BOOTSTRAP_PASSWORD 必须手动设置，否则脚本拒绝启动；上线后请立即轮换
# - 走 Nginx 反向代理时，把 CRF_SERVER_HOST 改为 127.0.0.1，仅本机回环监听

CRF_ENV=production
CRF_AUTH_SECRET_KEY=__GENERATED_SECRET__
CRF_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
CRF_ADMIN_BOOTSTRAP_PASSWORD=change-this-before-production
CRF_SERVER_HOST=0.0.0.0
CRF_SERVER_PORT=8888
CRF_DATABASE_PATH=./database/crf_editor.db
CRF_STORAGE_UPLOAD_PATH=./uploads
CRF_TEMPLATE_PATH=./database/template.db
