# CRF Editor Nginx 反向代理示例配置
# 使用前提：
#  1. 在 /etc/crf-editor/crf-editor.env 中把 CRF_SERVER_HOST 改为 127.0.0.1，
#     使后端仅监听本机回环，由 Nginx 对外提供服务
#  2. 本示例假设后端监听 127.0.0.1:8888（CRF_SERVER_PORT 默认 8888）
#  3. 若服务器已用 1panel / openresty 等面板占用 80/443（如本机），
#     请通过面板的「网站」功能添加反代站点，而不是直接放置本文件
# 部署步骤：复制为 /etc/nginx/conf.d/crf-editor.conf（按需改 server_name 与端口），
#           然后 nginx -t && nginx -s reload

server {
    listen 80;
    server_name crf.example.com;  # 替换为实际域名或服务器 IP

    # .db / .docx 项目导入与 Word 导入可能较大
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Word 导出（含 LibreOffice 目录页码预计算）与导入渲染耗时较长
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

